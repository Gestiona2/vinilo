---
interface Props {
  texto?: string;
  centro?: string;
}
const { texto = "MDL VINILOCOL · EST. 2019 · BOGOTÁ · GLOBAL ·", centro = "18+" } = Astro.props;
---

<div class="sello" aria-hidden="true">
  <svg class="sello-circular" viewBox="0 0 120 120">
    <defs>
      <path id="circulo-sello" d="M60,60 m-44,0 a44,44 0 1,1 88,0 a44,44 0 1,1 -88,0" />
    </defs>
    <circle cx="60" cy="60" r="57" fill="none" stroke="rgba(227,178,92,.22)" stroke-width="0.6" />
    <text><textPath href="#circulo-sello">{texto}</textPath></text>
  </svg>
  <span class="sello-centro">{centro}</span>
</div>

<style>
  .sello {
    position: relative; width: 100%; height: 100%; display: grid; place-items: center;
    border-radius: 50%; background: rgba(7, 6, 6, 0.55);
    -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
  }
  .sello-centro {
    position: absolute; font-family: var(--font-serif); font-style: italic;
    font-size: 1.35rem; color: var(--oro-claro);
  }
</style>
