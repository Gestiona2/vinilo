---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { conBase, enlace } from "../lib/ruta";
import dataBase from "../datos/legal.json";
import sitioBase from "../datos/sitio.json";

const data = conBase(dataBase);
const sitio = conBase(sitioBase);
---

<Layout
  activa=""
  titulo="Información legal — MDL VINILOCOL"
  descripcion="Términos, privacidad, contenido para adultos y política de pagos de MDL Vinilocol."
  noIndex
>
  <section class="cab-pagina">
    <div class="container">
      <div class="migas"><a href={enlace("/")}>Inicio</a> <span>/</span> <span>Legal</span></div>
      <p class="eyebrow">{data.eyebrow}</p>
      <h1>{data.titulo} <span class="serif oro-texto">{data.tituloAcento}</span></h1>
      <p class="texto-lead" style="max-width:60ch;margin-top:24px;">{data.texto}</p>
    </div>
  </section>

  <section class="seccion-sm">
    <div class="container legal-grid">
      <aside class="legal-nav">
        <p class="etiqueta-mini">En esta página</p>
        {data.secciones.map((s) => (
          <a href={`#${s.id}`}>{s.titulo}</a>
        ))}
        <a href={enlace("/contacto/")} class="btn btn-borde btn-sm" style="margin-top:22px;">¿Dudas? Escríbenos</a>
      </aside>

      <div class="legal-cuerpo">
        {data.secciones.map((s) => (
          <article id={s.id} class="legal-bloque">
            <span class="num">{String(data.secciones.indexOf(s) + 1).padStart(2, "0")}</span>
            <h2>{s.titulo}</h2>
            {s.parrafos.map((p) => <p>{p}</p>)}
          </article>
        ))}
        <div class="legal-pie">
          <Icon name="shield-check" size={20} />
          <p>
            Responsable: {sitio.razonSocial} · {sitio.ciudad} · <a href={`mailto:${sitio.correo}`}>{sitio.correo}</a> · <a href={`https://wa.me/${sitio.whatsapp}`} target="_blank" rel="noopener">{sitio.telefono}</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <style>
    .legal-grid { display: grid; grid-template-columns: 240px 1fr; gap: clamp(30px, 6vw, 90px); align-items: start; }
    .legal-nav { position: sticky; top: calc(var(--nav-alto) + 30px); display: flex; flex-direction: column; gap: 4px; }
    .etiqueta-mini { font-size: .58rem; letter-spacing: .2em; text-transform: uppercase; color: var(--texto-mudo); margin-bottom: 14px; }
    .legal-nav a:not(.btn) { font-size: .8rem; color: var(--texto-suave); padding: 9px 0; border-bottom: 1px solid var(--linea); transition: color .3s, padding-left .3s; }
    .legal-nav a:not(.btn):hover { color: var(--oro); padding-left: 6px; }
    .legal-bloque { padding: 0 0 42px; margin-bottom: 42px; border-bottom: 1px solid var(--linea); scroll-margin-top: calc(var(--nav-alto) + 30px); position: relative; }
    .legal-bloque .num { font-family: var(--font-serif); font-style: italic; font-size: 1rem; color: var(--oro); }
    .legal-bloque h2 { font-size: clamp(1.4rem, 2.4vw, 2rem); margin: 8px 0 18px; letter-spacing: -.03em; }
    .legal-bloque p { font-size: .9rem; color: var(--texto-mudo); line-height: 1.8; margin-bottom: 14px; max-width: 72ch; }
    .legal-pie { display: flex; gap: 12px; align-items: flex-start; padding: 22px; border: 1px solid var(--linea); border-radius: 12px; background: rgba(227,178,92,.04); }
    .legal-pie :global(svg) { color: var(--oro); flex: none; margin-top: 2px; }
    .legal-pie p { font-size: .78rem; color: var(--texto-mudo); line-height: 1.7; }
    .legal-pie a { color: var(--texto-suave); text-decoration: underline; text-underline-offset: 3px; }
    @media (max-width: 820px) { .legal-grid { grid-template-columns: 1fr; } .legal-nav { position: static; } }
  </style>
</Layout>
